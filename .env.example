# REQUIRED in production. Encrypts every reveal link.
# Generate with: openssl rand -base64 32
# Never change it after launch, or every link already sent stops working.
DRAW_SECRET=

# MET Norway requires an identifying User-Agent with your app name + contact.
MET_USER_AGENT="kadaradraw.com/0.1 https://kadaradraw.com"

# Paywall: "demo" unlocks big draws for free (shows a notice). "live" needs Paystack.
NEXT_PUBLIC_PAYWALL_MODE=demo

# Paystack (only needed when NEXT_PUBLIC_PAYWALL_MODE=live). Use test keys first.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# ---- Ajo payout-order draw ----
# Supabase, used ONLY by server route handlers with the service-role key
# (bypasses RLS; never expose it to the browser). Run supabase/migrations first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Local development / automated tests without Supabase: keep data in memory.
# Never set this in production.
# AJO_STORE=memory

# Reminder emails (Resend send API). Optional: without a key, no emails are sent.
RESEND_API_KEY=
# Sender for every automated email (server only). Must be a verified Resend sender.
# Replies go to NEXT_PUBLIC_EMAIL_SUPPORT; never send from support@ or info@ directly.
EMAIL_FROM="Kádàrá <reminders@kadaradraw.com>"
# Random string, required in production. Cron routes (reminders, cleanup) refuse every
# request without it. Vercel sends it as Authorization: Bearer $CRON_SECRET.
CRON_SECRET=
# Used to build links in emails and calendar files.
NEXT_PUBLIC_SITE_URL=https://kadaradraw.com

# ---- Contact (defaults shown; every address must be @kadaradraw.com) ----
NEXT_PUBLIC_KADARA_WHATSAPP=                         # the brand's own business WhatsApp, digits only (e.g. 2348012345678)
NEXT_PUBLIC_EMAIL_INFO=info@kadaradraw.com           # general questions, press, privacy requests
NEXT_PUBLIC_EMAIL_SALES=sales@kadaradraw.com         # offices, churches, Big circle, vendors who prefer email
NEXT_PUBLIC_EMAIL_SUPPORT=support@kadaradraw.com     # broken links, payments, reminders, reporting a vendor
NEXT_PUBLIC_EMAIL_PRIVACY=privacy@kadaradraw.com     # data access and deletion requests

# Shows "Draft, pending legal review" on /privacy and /terms until set to true.
LEGAL_REVIEWED=false

# ---- Gift Finder (/gifts) ----
# Reads the catalogue as the anon role, so the "active products only" rule applies.
# Uses SUPABASE_URL above. Run supabase/migrations first. See docs/adding-gifts.md.
SUPABASE_ANON_KEY=
# Orders go to each VENDOR's own WhatsApp (vendors.whatsapp), not a store number.
# The order button records a ref in gift_clicks with the service-role key above.
# Local development / automated tests without Supabase: "memory" shows the six
# [Sample] products, "empty" shows none. Never set this in production.
# GIFTS_STORE=memory
