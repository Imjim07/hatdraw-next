# REQUIRED in production. Encrypts every reveal link.
# Generate with: openssl rand -base64 32
# Never change it after launch, or every link already sent stops working.
DRAW_SECRET=

# MET Norway requires an identifying User-Agent with your app name + contact.
MET_USER_AGENT="HatDraw/0.1 https://capricornhub.com"

# Paywall: "demo" unlocks big draws for free (shows a notice). "live" needs Paystack.
NEXT_PUBLIC_PAYWALL_MODE=demo

# Paystack (only needed when NEXT_PUBLIC_PAYWALL_MODE=live). Use test keys first.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# ---- Ajo payout-order draw ----
# Supabase, used ONLY by server route handlers with the service-role key
# (bypasses RLS; never expose it to the browser). Run supabase/migrations first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Local development / automated tests without Supabase: keep data in memory.
# Never set this in production.
# AJO_STORE=memory

# Reminder emails (Resend send API). Optional: without a key, no emails are sent.
RESEND_API_KEY=
REMINDER_FROM_EMAIL="HatDraw <reminders@yourdomain.com>"
# The daily reminder cron must send: Authorization: Bearer $CRON_SECRET
CRON_SECRET=
# Used to build links in emails and calendar files, e.g. https://hatdraw.app
NEXT_PUBLIC_SITE_URL=
